# environments
vqaenv/
*.venv/
__pycache__/
.pytest_cache/
*.pyc

# data and run artifacts (large, regenerable)
# Leading slash anchors these to the repo ROOT. Without it, `data/` matches a
# directory named data at ANY depth - which silently excluded src/data/ and
# dropped the entire data pipeline (photometric.py, prepare_datasets.py,
# splits_and_yolo.py, build_cce_dataset.py) from the repository. A fresh clone
# could not prepare a dataset or build the CCE encoding at all.
/data/
/work/
/runs/
/outputs/
/checkpoints/
/logs/
*.pt
*.pth
*.zip

# notebook checkpoints and executed copies (outputs are regenerated)
.ipynb_checkpoints/
notebook/*_executed.ipynb

# first-study artefacts kept locally for reference only
archive/v1_results/preds/
archive/v1_runs_old_splits/
_old_splits_DELETE_ME/

# downloaded pretrained weights
weights_cache/

# figures ARE tracked: they are the paper deliverable and only ~10 MB.
# Regenerable from the notebook, but a repo a reviewer clones should render
# its own README diagrams without a GPU run first.

# smoke-test workspace, external generator repos and their exported inputs
/runs_smoke/
/external/
/runs_smoke_log.txt
